{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iphone-remote-pairing",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "PAIRING_SESSION", "class_name": "PairingSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingSession"] }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://bloibloi.github.io"
  }
}
